{
  "name": "quechua-novela-escritorio",
  "private": true,
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "empaquetar": "electron-builder --mac --win --linux"
  },
  "build": {
    "appId": "io.itch.lucumango.killa",
    "productName": "Killa",
    "files": [
      "main.js",
      "juego/**/*"
    ],
    "directories": {
      "output": "salida"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
