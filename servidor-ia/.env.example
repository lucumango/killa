# Copia este archivo a .env y pon TU clave. NUNCA subas .env a itch.io ni a GitHub.
# Va una de las dos: la de Google (AI Studio, https://aistudio.google.com/apikey)
# o la de Anthropic. El servidor se da cuenta sola de cuál pusiste.
GEMINI_API_KEY=AQ....
# ANTHROPIC_API_KEY=sk-ant-...
# Con las dos claves puestas gana Google. Para usar Claude: PROVEEDOR=anthropic
# PROVEEDOR=anthropic
# MODELO_ANTHROPIC=claude-haiku-5-5    # barato y rápido. Opus es 40x más caro

# Google: gemini-3.6-flash anda bien. Si se satura, se reintenta y después usa el de respaldo.
MODELO=gemini-3.6-flash
MODELO_RESPALDO=gemini-3.5-flash-lite
# PENSAR=0   # 0 = contesta rapidísimo. Súbelo (ej. 512) si quieres respuestas más pensadas

# En tu compu. En Render NO pongas esto: Render manda el puerto en PORT.
PUERTO=8787

# Desde qué dominios se puede llamar, separados por coma.
# Se admite * al principio: *.hwcdn.net cubre los subdominios al azar de itch.io.
ORIGENES=http://localhost:8765,https://*.hwcdn.net,https://*.itch.zone,https://itch.io

# Cuántos mensajes por minuto aguanta cada jugador (para que no te quemen la clave).
LIMITE_POR_MINUTO=20

# Estudio: clave para bajarte los registros desde /estudio?clave=...
# Si la dejas vacía, ese endpoint queda cerrado.
CLAVE_ESTUDIO=
